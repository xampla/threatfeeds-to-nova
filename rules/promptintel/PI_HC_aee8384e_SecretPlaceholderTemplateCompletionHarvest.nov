rule PI_HC_aee8384e_SecretPlaceholderTemplateCompletionHarvest
{
    meta:
        description = "Detects credential harvesting templates that present secret placeholders such as API key, secret key, or database URL and ask the model to complete or expand them with real values from its context"
        author = "PromptIntel"
        version = "1.0.0"
        category = "abusing_functions/credential_harvesting"
        severity = "medium"
        uuid = "2fef6dd2-c661-4c93-b51c-e6065d67a645"
        date = "2026-08-16"
        promptintel_url = "https://promptintel.novahunting.ai/prompt/cf13be1e-64bd-4993-9762-d5f388d00c30"

    keywords:
        $template_instruction = /complete\s+this\s+template|fill\s+in\s+the\s+(blanks?|template|values?)|generate\s+embeddings\s+for|continue\s+this\s+text\s+exactly/i
        $secret_placeholder = /\{\{\s*(api[_-]?key|secret[_-]?key|database[_-]?url|access[_-]?token|password|aws_secret_access_key)\s*\}\}/i
        $secret_env_names = /openai_api_key|anthropic_api_key|aws_secret_access_key|secret_key[^.]{0,40}database_url|database_url[^.]{0,40}secret_key/i
        $my_secret_is = /my\s+(api\s+key|secret|token|password)\s+is\b/i

    semantics:
        $secret_completion_intent = "template built so the assistant fills in real API keys tokens or database credentials taken from its context" (0.45)

    condition:
        (keywords.$template_instruction or semantics.$secret_completion_intent)
        and
        (keywords.$secret_placeholder or keywords.$secret_env_names or keywords.$my_secret_is)
}
