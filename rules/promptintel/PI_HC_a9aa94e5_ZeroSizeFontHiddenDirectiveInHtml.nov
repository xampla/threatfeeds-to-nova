rule PI_HC_a9aa94e5_ZeroSizeFontHiddenDirectiveInHtml
{
    meta:
        description = "Detects indirect prompt injection where markup hides an instruction for the AI assistant behind invisible styling such as zero font size, display none, or hidden visibility inside otherwise ordinary page content"
        author = "PromptIntel"
        version = "1.0.0"
        category = "prompt_manipulation/indirect_injection"
        severity = "medium"
        uuid = "110479a3-4170-407c-a2d6-8469fdfdb713"
        date = "2026-08-16"
        promptintel_url = "https://promptintel.novahunting.ai/prompt/63bb6d59-5307-446c-85c8-55b871fe7ae1"

    keywords:
        $zero_font = /font-size:\s*0(\.0+)?(px|pt|rem|em|%)?\s*[;"']/i
        $hidden_css = /display:\s*none|visibility:\s*hidden|opacity:\s*0\s*[;"']|color:\s*#?fff(fff)?\s*[;"']/i
        $assistant_directive = /(ignore|disregard|forget)\s+(all\s+)?(previous|prior|above)\s+(instructions?|prompts?)|act\s+now\s+to\s+prevent|(you\s+must|please)\s+(now\s+)?(send|forward|email|transmit|execute|run|delete|upload)/i

    semantics:
        $hidden_instruction_intent = "instruction text hidden from the human reader inside invisible markup so only the AI assistant reading the page acts on it" (0.45)

    llm:
        $hidden_ai_directive = "Does this input hide an instruction inside invisible markup so that only an AI assistant reading the page would act on it, for example telling it to send, forward, delete or execute something? Answer no when the hidden markup contains ordinary content and no when the text is a CSS question or an accessibility review." (0.6)

    condition:
        (keywords.$zero_font or keywords.$hidden_css)
        and
        (keywords.$assistant_directive or semantics.$hidden_instruction_intent or llm.$hidden_ai_directive)
}
