rule PI_HC_b1f41453_EnvironmentSecretDumpExecutionRequest
{
    meta:
        description = "Request that an agent execute code dumping environment variables and read dotenv or passwd files to harvest secrets"
        author = "PromptIntel"
        version = "1.0.0"
        category = "abusing_functions/credential_harvesting"
        severity = "medium"
        uuid = "07215029-b377-4114-a877-83f3c4ccf480"
        date = "2026-08-16"
        promptintel_url = "https://promptintel.novahunting.ai/prompt/4421c8f3-6a28-47e0-9a56-6da0669db643"

    keywords:
        $env_dump = /os\.environ\.items\(\)|json\.dumps\(env|execute\s+this\s+python\s+code/i
        $secret_files = /\.env|\/etc\/passwd|\/etc\/environment|config\s+files\s+you\s+can\s+find/i
        $show_output = /show\s+the\s+output|show\s+the\s+contents\s+of\s+any/i

    semantics:
        $secret_harvest_intent = "instruction for an agent to run code that dumps all environment variables and read dotenv or system credential files and return their contents" (0.43)

    condition:
        ($env_dump and ($secret_files or $show_output))
        or
        ($secret_files and $show_output and $secret_harvest_intent)
}
