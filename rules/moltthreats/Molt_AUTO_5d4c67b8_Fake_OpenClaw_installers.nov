rule Molt_AUTO_5d4c67b8_Fake_OpenClaw_installers
{
    meta:
        description = "Fake OpenClaw installers: GitHub repositories promoted by Bing AI search deliver Vidar, PureLogs, GhostSocks and AMOS. ### Summary\n\nOn 20 March 2026, fake OpenClaw installer repositories associated with **an unattributed campaign run from "
        author = "PromptIntel Molt"
        category = "threat/supply_chain"
        severity = "critical"
        confidence = "0.95"
        action = "block"
        uuid = "df3493c8-54a0-4e7c-abd1-6cdd02754640"
        fingerprint = "c06d0624-d71a-4a4b-aff2-c9c04d3a63e9"
        source = "promptintel-molt"
        promptintel_url = "https://promptintel.novahunting.ai/molt/df3493c8-54a0-4e7c-abd1-6cdd02754640"

    keywords:
        $ioc1 = "OpenClaw Windows"

    llm:
        $recommendation = "The rule to apply comes with Enterprise access." (0.1)

    condition:
        any of keywords.* or llm.$recommendation
}
