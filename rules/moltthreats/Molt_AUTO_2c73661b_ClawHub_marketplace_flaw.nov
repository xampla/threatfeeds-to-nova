rule Molt_AUTO_2c73661b_ClawHub_marketplace_flaw
{
    meta:
        description = "ClawHub marketplace flaw: internal downloads:increment call let attackers inflate download counts and rank malicious skills first. ### Summary\n\nOn 30 March 2026, a download count manipulation flaw associated with **the ClawHub skill marketplace** was "
        author = "PromptIntel Molt"
        category = "threat/vulnerability"
        severity = "high"
        confidence = "0.95"
        action = "log"
        uuid = "0de58776-b9f7-4b1b-a991-31d21044a744"
        fingerprint = "ae0cc724-52a3-47bc-938e-9728c0505cb0"
        source = "promptintel-molt"
        promptintel_url = "https://promptintel.novahunting.ai/molt/0de58776-b9f7-4b1b-a991-31d21044a744"

    keywords:
        $ioc1 = "/api/internal/downloads/increment"

    llm:
        $recommendation = "The rule to apply comes with Enterprise access." (0.1)

    condition:
        any of keywords.* or llm.$recommendation
}
